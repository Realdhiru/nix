/* =========================================================
   GLOBAL & BASICS - Sleek Neutral Dark Theme
========================================================= */
QWidget {
    font-family: "JetBrains Mono";
    font-size: 11pt;
    color: #EDE6DC;
}

QMainWindow, QDialog {
    background-color: #121318;
}

QToolTip {
    background-color: #1a1b24;
    color: #EDE6DC;
    border: 1px solid #282a36;
    border-radius: 6px;
    padding: 6px;
}

/* =========================================================
   BUTTONS
========================================================= */
QPushButton {
    background-color: #1e2029;
    color: #EDE6DC;
    border: 1px solid #2b2d3a;
    border-radius: 6px;
    padding: 6px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #2b2d3a;
    border: 1px solid {{color4}};
}

QPushButton:pressed, QPushButton:checked {
    background-color: {{color4}};
    color: #121318;
    border: 1px solid {{color4}};
}

QPushButton:disabled {
    background-color: #16171f;
    color: #555768;
    border: 1px solid transparent;
}

/* =========================================================
   INPUTS (Spinners, Dropdowns only)
========================================================= */
QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #16171f;
    color: #EDE6DC;
    border: 1px solid #2b2d3a;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: {{color4}};
    selection-color: #121318;
}

QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 2px solid {{color4}};
    padding: 5px 9px;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #EDE6DC;
    margin-right: 10px;
}

/* =========================================================
   CHECKBOXES & RADIOS
========================================================= */
QCheckBox, QRadioButton {
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    background-color: #16171f;
    border: 2px solid #2b2d3a;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 11px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border: 2px solid {{color4}};
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: {{color4}};
    border: 2px solid {{color4}};
}

QRadioButton::indicator:checked {
    width: 10px;
    height: 10px;
    border: 6px solid {{color4}};
    background-color: #16171f;
}

/* =========================================================
   SLIDERS & PROGRESS BARS
========================================================= */
QSlider::groove:horizontal {
    border-radius: 3px;
    height: 6px;
    background: #222430;
}

QSlider::sub-page:horizontal {
    background: {{color4}};
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: {{color4}};
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #EDE6DC;
    border: 2px solid {{color4}};
}

QProgressBar {
    background-color: #1e2029;
    border-radius: 6px;
    text-align: center;
    color: #EDE6DC;
}

QProgressBar::chunk {
    background-color: {{color4}};
    border-radius: 6px;
}

/* =========================================================
   TABS & GROUP BOXES
========================================================= */
QTabWidget::pane {
    border: 1px solid #222430;
    border-radius: 8px;
    background: #121318;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: #A89F95;
    padding: 8px 16px;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:hover {
    color: #EDE6DC;
    background: #16171f;
}

QTabBar::tab:selected {
    color: {{color4}};
    border-bottom: 2px solid {{color4}};
    font-weight: bold;
}

QGroupBox {
    border: 1px solid #222430;
    border-radius: 8px;
    margin-top: 16px;
    padding-top: 16px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: {{color4}};
    font-weight: bold;
}

/* =========================================================
   VIEWS (Lists, Trees, Tables)
========================================================= */
QTreeView, QListView, QTableView {
    background-color: #121318;
    alternate-background-color: #16171f;
    border: 1px solid #222430;
    border-radius: 6px;
    gridline-color: #222430;
    color: #EDE6DC;
}

QTreeView::item:hover, QListView::item:hover, QTableView::item:hover {
    background-color: #1c1e28;
}

QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
    background-color: {{color4}};
    color: #121318;
}

/* =========================================================
   MENUS
========================================================= */
QMenuBar {
    background-color: transparent;
    color: #EDE6DC;
}

QMenuBar::item:selected {
    background-color: #222430;
    border-radius: 4px;
}

QMenu {
    background-color: #16171f;
    border: 1px solid #282a36;
    border-radius: 8px;
    padding: 6px;
    color: #EDE6DC;
}

QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: {{color4}};
    color: #121318;
}

/* =========================================================
   SCROLLBARS
========================================================= */
QScrollBar:vertical {
    border: none;
    background: #121318;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #282a36;
    min-height: 30px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: {{color4}};
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
